    "page_suffix": "Pages may carry a letter suffix (S197c, Supp. 305a).",
    "stale_after_months": 12,
    "stale_note": "Fla. L. Weekly is cited only for cases not published in Southern Reporter (9.800(a)(3), (b)(2)). Decisions usually reach So. 3d within months; the 2026 opinions in the test corpus cite Fla. L. Weekly only for decisions under four months old. A main-edition cite more than 12 months older than the document is flagged as a check."
  },
  "case_numbers": {
    "source": "Rule 9.800(a)(3), (b)(2) as amended by SC2025-0241 (effective 2026-09-01): four-digit year and four-digit case number, e.g. SC2000-0280, 1D2001-2734.",
    "new_form_effective": "2026-09-01",
    "prefixes": [
      "SC",
      "1D",
      "2D",
      "3D",
      "4D",
      "5D",
      "6D"
    ],
    "two_digit_century_cutoff": 26,
    "century_note": "Old forms used a two-digit year. 00-26 are read as 20YY and 27-99 as 19YY: courts stopped issuing the old form before 2027, so no old-form number can mean 2027 or later."
  },
